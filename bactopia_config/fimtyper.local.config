// FimTyper Nextflow config for the scheduler-free "local" backend.
// process.executor = 'local' so FimTyper runs as a local subprocess (no sbatch/qsub).
// Based on fimtyper.slurm.config with the Slurm executor/queue/clusterOptions removed.

def singCache = System.getenv('SING_CACHE') ?: "${System.getenv('HOME')}/singularity_cache"

process {
  executor = 'local'
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int

  beforeScript = '''
export TERM="${TERM:-dumb}"
export SINGULARITYENV_TERM=dumb
'''

  withName: 'FIMTYPER' {
    container = System.getenv('FIMTYPER_CONTAINER') ?: "${singCache}/fimtyper.sif"
  }
}

executor {
  queueSize = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int
  cpus = (System.getenv('LOCAL_MAX_CPUS') ?: '4') as int
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = singCache
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}
